# E2E 联调配置模板。复制为 app/e2e.properties 并填入你的真实服务器信息。
# app/e2e.properties 已被 .gitignore 排除，不会进入仓库。
# 也可以改用环境变量或 JVM 系统属性（同名 key），优先级：环境变量 > 系统属性 > 本文件。
WEBDAV_E2E_SERVER=http://192.168.x.x:5244/dav
WEBDAV_E2E_USER=admin
WEBDAV_E2E_PASS=your-password
# 选一个文件较少的目录，测试会下载其中第一个文件
WEBDAV_E2E_DIR=/some/small/dir
